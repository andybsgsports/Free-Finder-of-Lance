{
  "name": "3dprint",
  "title": "3D print product gaps — things people want and can't buy",
  "minScore": 5,
  "sources": [
    { "type": "reddit", "name": "3Drequests" },
    { "type": "reddit", "name": "3Dprintmything" },
    { "type": "reddit", "name": "functionalprint" },
    { "type": "reddit", "name": "3Dprinting" },
    { "type": "reddit", "name": "astrophotography" },
    { "type": "reddit", "name": "telescopes" }
  ],
  "signals": {
    "request": {
      "weight": 3,
      "patterns": [
        "can (someone|anyone) (design|make|model|print|draw)",
        "looking for (a |an )?(model|stl|design|part|bracket|mount|adapter)",
        "does anyone (have|know of|make)",
        "request",
        "need (a|an) (part|bracket|mount|holder|adapter|clip|case|shield)",
        "wish (there was|someone made|i could find)",
        "ca?n'?t find"
      ]
    },
    "gap": {
      "weight": 3,
      "patterns": [
        "does ?n'?t exist|do(es)? not exist",
        "(no ?one|nobody) makes",
        "discontinued|out of production|obsolete|no longer (made|available)",
        "replacement (part|piece|clip|bracket)",
        "broke.{0,25}(replace|repair)",
        "out of stock everywhere"
      ]
    },
    "niche": {
      "weight": 2,
      "patterns": [
        "telescope|eyepiece|focuser|dovetail|counterweight",
        "dew (shield|heater|strap)|bahtinov",
        "filter (holder|drawer|wheel)",
        "camera (adapter|mount|bracket)",
        "tripod|ball ?head",
        "cable (management|routing|clip)"
      ]
    },
    "willingness": {
      "weight": 2,
      "patterns": [
        "willing to pay",
        "would (buy|pay|purchase)",
        "i'?d (buy|pay)",
        "take my money",
        "\\$\\s?\\d",
        "where can i buy"
      ]
    }
  },
  "exclude": [
    "\\[fs\\]|for sale|selling my|giveaway",
    "(just )?(printed|made|finished) (this|my)",
    "first (print|layer|attempt)",
    "print quality|stringing|adhesion|warping|elephant ?foot",
    "which printer should i (buy|get)",
    "what (slicer|filament) ",
    "my (latest|newest) (print|design)"
  ]
}
